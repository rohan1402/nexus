# ── Lyzr ADK ────────────────────────────────────────────────────────────────
# Required to run agents against the real Lyzr cloud. Get one at https://studio.lyzr.ai
LYZR_API_KEY=

# LLM provider + model every agent uses (a "provider/model" string).
NEXUS_LLM_PROVIDER=google/gemini-2.5-pro

# ID of the Gemini LLM credential configured in your Lyzr account.
# (Lyzr stores your Google/Gemini API key as a named credential and references it by id.)
LYZR_LLM_CREDENTIAL_ID=lyzr_google

# ── Nexus runtime ─────────────────────────────────────────────────────────────
# Which backend executes agents: "lyzr" (real cloud) or "mock" (deterministic, offline).
NEXUS_RUNTIME=mock

# Validator confidence threshold (0.0–1.0). Below this, the Validator rejects the
# generated tests and sends them back to the Test Generator (bounded retries).
NEXUS_CONFIDENCE_THRESHOLD=0.7

# ── GitHub (PR Writer only) ───────────────────────────────────────────────────
# Token with `repo` scope, used by the PR Writer to open pull requests.
GITHUB_TOKEN=
